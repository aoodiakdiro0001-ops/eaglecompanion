# قاعدة البيانات المحلية (اختياري) — افتراضي: ./data/eagle.db
# DATABASE_PATH=./data/eagle.db
# :memory: للاختبارات فقط

# Turso (سحابة مجانية) — في النشر على Vercel:
# TURSO_DATABASE_URL=libsql://xxxx.turso.io
# TURSO_AUTH_TOKEN=eyJ...

# سر توقيع أكواد الاقتران والدعوات (HMAC-SHA256). إلزامي في الإنتاج.
# تغييره يلغي كل الأكواد غير المستخدمة.
SESSION_SECRET=change-me-in-production
